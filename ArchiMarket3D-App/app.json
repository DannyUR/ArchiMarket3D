{
  "expo": {
    "name": "ArchiMarket3D",
    "slug": "archimarket3d",
    "version": "1.0.0",
    "scheme": "archimarket3d",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.archimarket3d.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.archimarket3d.app",
      "permissions": ["INTERNET"],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "archimarket3d",
              "host": "*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "2bef0d86-cd06-4810-bc8f-b48f6465cd08"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2bef0d86-cd06-4810-bc8f-b48f6465cd08"
    }
  }
}